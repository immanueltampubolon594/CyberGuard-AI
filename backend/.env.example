# Salin file ini menjadi ".env" (di folder backend), lalu isi dengan kunci MILIK ANDA SENDIRI.
# Jangan pernah meng-commit file .env, dan jangan membagikan isinya lewat chat atau email.

# --- Basis data ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Chatbot RAG ---
COHERE_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# --- Analisis isi audio (kunci dan model terpisah dari chatbot RAG) ---
# Jika GEMINI_AUDIO_API_KEY kosong, dipakai GOOGLE_API_KEY.
GEMINI_AUDIO_API_KEY=
GEMINI_AUDIO_MODEL=gemini-3.5-flash-lite

# --- Pemantauan (opsional) ---
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=

# --- Verifikasi link ---
GOOGLE_SAFE_BROWSING_KEY=
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
URLHAUS_API_KEY=
ABUSEIPDB_API_KEY=
WHOISXML_API_KEY=
MICROLINK_API_KEY=
